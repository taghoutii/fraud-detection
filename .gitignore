# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Data (never commit raw IEEE-CIS data — it's ~1.2GB and licensed via Kaggle)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# Models (keep repo light; commit only a small final demo pipeline if you want)
models/*.pkl
models/*.joblib
!models/.gitkeep
# INTENTIONAL EXCEPTION -- do not "clean up": final_pipeline.joblib (~15 MB) is tracked on
# purpose. The API (app/), its tests in CI, and the Docker image all load it, and a fresh
# clone has no data to retrain it from. Every other model file stays ignored.
!models/final_pipeline.joblib

# MLflow
mlruns/

# Env / secrets
.env
kaggle.json

# OS
.DS_Store
Thumbs.db

.env
*.env
reports/results/*.log
